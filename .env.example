# Dolores backend origin reachable by the Next.js runtime; omit /api/v1.
DOLORES_API_URL=http://192.168.1.125:8082

# IDaaS login API. Use the public BEANS IDaaS server IP and port, including /api/v1.
# The Next.js server probes the IP first and uses localhost if it is unavailable.
# IDAAS_API_IP_URL=http://<BEANS_IDAAS_IP>:4000/api/v1
IDAAS_API_LOCAL_URL=http://localhost:4000/api/v1
