# Remote Dolores backend origin; set both remote URLs for paired failover. Omit /api/v1.
DOLORES_API_IP_URL=http://100.75.202.72:8082
# Local Docker Dolores backend used automatically when the remote health check fails.
DOLORES_API_LOCAL_URL=http://localhost:8082
# Legacy remote origin; used only when DOLORES_API_IP_URL is not set.
DOLORES_API_URL=http://100.75.202.72:8082

# IDaaS login API. If either remote health check fails, both APIs use local Docker.
# Use the same remote backend environment and include /api/v1.
IDAAS_API_IP_URL=http://100.75.202.72:4000/api/v1
IDAAS_API_LOCAL_URL=http://localhost:4000/api/v1

# Must match the IDaaS refresh cookie Path when it differs from the default.
IDAAS_REFRESH_COOKIE_PATH=/api/v1/auth
